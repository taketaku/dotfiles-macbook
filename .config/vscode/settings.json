{
  "vim.useSystemClipboard": true,
  "go.formatTool": "goimports",
  "window.zoomLevel": 1,
  "sql-formatter.dialect": "pl/sql",
  "go.useLanguageServer": true,
  "workbench.editor.closeEmptyGroups": false,
  "editor.minimap.enabled": false,
  "workbench.editor.enablePreview": false,
  "workbench.sideBar.location": "left",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[go]": {
    "editor.tabSize": 4
  },
  "javascript.updateImportsOnFileMove.enabled": "always",
  "vetur.useWorkspaceDependencies": true,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.nuxt/**": true,
    "**/.dist/**": true,
    "**/node_modules/*/**": true
  },
  "terraform.indexing": {
    "enabled": false,
    "liveIndexing": false,
    "delay": 500,
    "exclude": [".terraform/**/*", "**/.terraform/**/*"]
  },
  "terraform.languageServer": {
    "enabled": true,
    "args": []
  },
  "terminal.integrated.fontFamily": "Source Code Pro for Powerline",
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.rulers": [80],
    "editor.selectionHighlight": false,
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.suggestSelection": "first",
    "editor.tabCompletion": "onlySnippets",
    "editor.wordBasedSuggestions": "off"
  },
  "dart.flutterSdkPath": "/Users/taketaku/flutter",
  "dart.openDevTools": "flutter",
  "vscode-neovim.neovimInitVimPaths.darwin": "/Users/tt/.config/nvim/init.vim",
  "vscode-neovim.neovimExecutablePaths.darwin": "/usr/local/bin/nvim",
  "vscode-neovim.useCtrlKeysForInsertMode": false,
  "vscode-neovim.useCtrlKeysForNormalMode": false,
  "editor.scrollBeyondLastLine": false,
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.cursorStyle": "line",
  "editor.lineNumbers": "on",
  "editor.wordSeparators": "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`?-",
  "editor.wordWrap": "off",
  "json.maxItemsComputed": 50000,
  "dart.debugExternalPackageLibraries": false,
  "dart.debugSdkLibraries": false,
  "editor.detectIndentation": false,
  "[ruby]": {
    "editor.defaultFormatter": "SimonSiefke.prettier-vscode"
  },
  "editor.renderWhitespace": "boundary",
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "editor.accessibilitySupport": "off",
  "editor.defaultFormatter": "rvest.vs-code-prettier-eslint",
  "githubPullRequests.pullBranch": "never",
  "terminal.integrated.shellIntegration.enabled": false,
  "github.copilot.editor.enableAutoCompletions": true,
  "svelte.enable-ts-plugin": true,
  "sherlock.userId": "fec2b7d2-b815-470f-9af0-f53b49bea100",
  "git.openRepositoryInParentFolders": "always",
  "editor.tabSize": 2,
  "roo-cline.allowedCommands": [
    "npm test",
    "npm install",
    "tsc",
    "git log",
    "git diff",
    "git show"
  ],
  "remote.autoForwardPortsSource": "hybrid",
  "github.copilot.nextEditSuggestions.enabled": true,
  "workbench.startupEditor": "none",
  "chat.instructionsFilesLocations": {
    ".github/instructions": true
  }
}
